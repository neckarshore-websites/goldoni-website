# Goldoni: secrets for the inquiry forms. Copy to `.env.local` (gitignored) for
# local dev; Production sets them in Vercel.
#
# Everything that is not a secret (SMTP host, port, user, sender, recipients, the
# public Turnstile site key, the captcha switch) lives in src/lib/kontakt-config.ts,
# not here (planning #2879).
#
# Without SMTP_PASS, development logs the would-be mail to the server console and
# production shows the guest an honest error ("bitte rufen Sie uns kurz an").

# Password of the mailbox named in KONTAKT.smtpUser.
SMTP_PASS=

# Cloudflare Turnstile secret key. Without it the widget does not render.
TURNSTILE_SECRET_KEY=

# Token for the diagnostic endpoint src/app/api/smtp-verify. Long random string;
# any mismatch returns 404. Remove the variable to disable the endpoint.
SMTP_VERIFY_TOKEN=
