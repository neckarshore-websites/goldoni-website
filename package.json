{
  "name": "goldoni-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3002",
    "druck:sync": "node scripts/sync-print-assets.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:5g": "node scripts/lighthouse.mjs --quick --profile=mobile-5g",
    "lighthouse:desktop": "node scripts/lighthouse.mjs --quick --profile=desktop",
    "lighthouse:mobile": "node scripts/lighthouse.mjs --quick --profile=mobile-4g",
    "lighthouse:quick": "node scripts/lighthouse.mjs --quick",
    "lint": "eslint",
    "mail:preview": "tsx scripts/mail-preview.mjs",
    "pruef:druck-qr": "node --experimental-strip-types scripts/scan-print-qr.mjs",
    "qr:storefront": "tsx scripts/generate-storefront-qr.ts",
    "signaturen": "tsx scripts/generate-signatures.ts",
    "start": "next start -p 3002",
    "test:bildherkunft:unit": "tsx tests/delivery/bild-herkunft.test.ts",
    "test:delivery:unit": "tsx tests/delivery/channel-model.test.ts",
    "test:druck:unit": "tsx tests/delivery/print-assets.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @external",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:hinweis:unit": "tsx tests/delivery/printer-note.test.ts",
    "test:lighthouse:unit": "node --test scripts/lighthouse-profiles.test.mjs",
    "test:qr:print:unit": "tsx tests/delivery/print-qr.test.ts",
    "test:qr:unit": "tsx tests/delivery/storefront-qr.test.ts",
    "test:redirect:unit": "tsx tests/delivery/order-redirect.test.ts",
    "test:schema:unit": "tsx tests/delivery/order-action.test.ts",
    "test:search:unit": "NODE_ENV=production tsx tests/search/index-data.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "next": "16.2.12",
    "nodemailer": "9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsqr": "1.4.0",
    "lighthouse": "13.0.3",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.12",
    "js-yaml": "4.2.0",
    "@babel/core": "7.29.6"
  }
}
